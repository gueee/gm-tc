# Database Configuration
# SQLite for local development:
DATABASE_URL=sqlite:///./gmtc.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/gmtc

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_PORT=8000
API_HOST=0.0.0.0

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://gm-tc.tech

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
